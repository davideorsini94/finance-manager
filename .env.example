# Postgres
POSTGRES_DB=finance_manager
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
NODE_ENV=production
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=finance-attachments
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# NB: la configurazione SMTP si gestisce dalla UI (Impostazioni → SMTP, solo admin).
# La password SMTP viene cifrata at-rest con AES-256-GCM (chiave derivata da
# JWT_ACCESS_SECRET). NON impostare le variabili MAIL_* in env.

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api

# nginx (reverse proxy)
HTTP_PORT=80

# URL pubblica usata SOLO come fallback estremo per costruire i link nelle
# email (invito / reset password / notifiche di condivisione) quando per
# qualche motivo manca l'header Host della request.
# In funzionamento normale i link riflettono automaticamente l'URL da cui
# hai aperto l'app (LAN, dominio, ngrok, ...) — quindi NON serve impostarla
# in modo cablato. Lascia commentata se non hai un caso particolare.
# APP_PUBLIC_URL=https://finance.example.com

# Admin seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin
